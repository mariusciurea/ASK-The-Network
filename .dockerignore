# Keep the build context small and free of local state.
.git
.gitignore
.idea
.venv
**/__pycache__
**/*.pyc
**/*.pyo

# local runtime state - must never be baked into an image
.env
*.db
logs/
backend/network_agent/.adk/

# not needed at runtime
docs/
backend/tests/
README.md
**/README.md
docker-compose.yaml
